#!/bin/bash
# Tool to manage and verify the keyring unlock secret.
set -euo pipefail

# Parse command-line options
if [ $# -gt 0 ]; then
    case "$1" in
        -n)
            DISPLAY=
            export DISPLAY
            ;;
        -h|--help)
            echo "Usage: $(basename "$0") [-n] [-h|--help]"
            echo
            echo "Manage and verify the keyring unlock secret."
            echo
            echo "Options:"
            echo "  -n          Clear the DISPLAY variable to force console pinentry prompt"
            echo "  -h, --help  Show this help message and exit"
            exit 0
            ;;
        *)
            echo "Error: Unknown option: $1" >&2
            echo "Usage: $(basename "$0") [-n] [-h|--help]" >&2
            exit 1
            ;;
    esac
fi

KEY_PATH="foo/bar"
STORE_PATH="${PASSWORD_STORE_DIR:-$HOME/.password-store}"
KEY_FILE="$STORE_PATH/$KEY_PATH.gpg"
KEYGRIP_FILE="$STORE_PATH/.keygrip"

# 1. Fast-path: Check if key is already cached in gpg-agent memory
if [ -f "$KEYGRIP_FILE" ]; then
    _KEYGRIP="$(cat "$KEYGRIP_FILE")"
    if [ -n "$_KEYGRIP" ]; then
        _INFO="$(gpg-connect-agent "keyinfo $_KEYGRIP" /bye 2>/dev/null || true)"
        # S KEYINFO <grip> <type> <serial> <id> <cached> <protection> ...
        # Field 7 (_cached) is '1' if cached in memory, '-' or '0' if locked
        read -r _s _keyinfo _grip _type _serial _id _cached _rest <<< "$_INFO"
        if [ "$_cached" = "1" ]; then
            exit 0
        fi
    fi
fi

# 2. If foo/bar does not exist, create it with the value 'unlock-keyring' using pass
if [ ! -f "$KEY_FILE" ]; then
    echo "Creating keyring unlock secret at $KEY_PATH..." >&2
    if ! echo "unlock-keyring" | pass insert -e -f "$KEY_PATH" >/dev/null; then
        echo "Error: Failed to initialize secret in pass." >&2
        exit 1
    fi
fi

# 4. Direct GPG decryption fallback (much faster than 'pass show')
unlocked="$(gpg --decrypt --quiet "$KEY_FILE" 2>/dev/null || true)"
if [ "$unlocked" = "unlock-keyring" ]; then
    # Cache keygrip for fast-path on subsequent runs
    if [ ! -f "$KEYGRIP_FILE" ]; then
        _KEYID="$(gpg --list-packets "$KEY_FILE" 2>/dev/null | awk '/keyid/ {print $NF; exit}')"
        if [ -n "$_KEYID" ]; then
            gpg --with-keygrip -k "$_KEYID" 2>/dev/null | awk '/Keygrip/ {print $NF; exit}' > "$KEYGRIP_FILE" || true
        fi
    fi
    exit 0
else
    echo "Wrong password retrieved" >&2
    exit 1
fi
