#!/bin/bash
# Tool to manage and verify the keyring unlock secret.
set -eu

# Parse command-line options
if [ $# -gt 0 ]; then
    case "$1" in
        -n)
            DISPLAY=
            export DISPLAY
            ;;
        -h|--help)
            echo "Usage: $(basename "$0") [-n] [-h|--help]"
            echo
            echo "Manage and verify the keyring unlock secret."
            echo
            echo "Options:"
            echo "  -n          Clear the DISPLAY variable to force console pinentry prompt"
            echo "  -h, --help  Show this help message and exit"
            exit 0
            ;;
        *)
            echo "Error: Unknown option: $1" >&2
            echo "Usage: $(basename "$0") [-n] [-h|--help]" >&2
            exit 1
            ;;
    esac
fi

KEY_PATH="local/keyring"
STORE_PATH="${PASSWORD_STORE_DIR:-$HOME/.password-store}"
KEY_FILE="$STORE_PATH/$KEY_PATH.gpg"

# 1. Fast-path: Check if any secret key is already cached in gpg-agent memory
if gpg-connect-agent "keyinfo --list" /bye 2>/dev/null | awk '$1=="S" && $2=="KEYINFO" && $7=="1" {found=1; exit} END {exit !found}'; then
    exit 0
fi

# 2. If local/keyring does not exist, create it with the value 'unlocked' using pass
if [ ! -f "$KEY_FILE" ]; then
    echo "Creating keyring unlock secret at $KEY_PATH..." >&2
    if ! echo "unlocked" | pass insert -e -f "$KEY_PATH" >/dev/null; then
        echo "Error: Failed to initialize secret in pass." >&2
        exit 1
    fi
fi

# 3. Direct GPG decryption fallback (prompts pinentry if locked)
unlocked="$(gpg --decrypt --quiet "$KEY_FILE" 2>/dev/null || true)"
if [ "$unlocked" = "unlocked" ]; then
    exit 0
else
    echo "Wrong password retrieved" >&2
    exit 1
fi
